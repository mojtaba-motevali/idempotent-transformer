{
  "name": "SyncShield",
  "version": "0.1.0",
  "description": "A solution for distributed services to ensure idempotency at task level in workflows.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "clean": "rimraf dist",
    "prepublishOnly": "npm test && npm run lint",
    "build:all": "pnpm install && pnpm -r run build",
    "build:redis": "pnpm --filter @idempotent-transformer/adapter-redis build",
    "publish:all": "pnpm install && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@faker-js/faker": "^9.8.0",
    "@types/chai": "^4.3.11",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.20",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "chai": "^4.3.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "typescript",
    "transformer",
    "idempotent"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f",
  "pnpm": {
    "overrides": {
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "protobufjs@<7.5.5": ">=7.5.5",
      "tar@<7.5.11": ">=7.5.11",
      "minimatch@9": ">=9.0.7",
      "minimatch@5": ">=5.1.8",
      "minimatch@3": ">=3.1.4",
      "flatted@<3.4.2": ">=3.4.2",
      "picomatch@<2.3.2": ">=2.3.2",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4",
      "file-type@>=13.0.0 <21.3.2": ">=21.3.2",
      "uuid@>=11.0.0 <11.1.1": ">=11.1.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "js-yaml@3": ">=3.14.2",
      "js-yaml@4": ">=4.1.1",
      "ajv@<6.14.0": ">=6.14.0",
      "@nestjs/core@<=11.1.17": ">=11.1.18"
    }
  }
}
